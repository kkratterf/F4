{
  "sourceLanguage": "en",
  "strings": {
    "%@ is taken by another app. Record a different shortcut.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già usata da un'altra app. Registra un'altra scorciatoia."
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi"
          }
        }
      }
    },
    "Add GIFs and stickers. You can also paste them with ⌘V or drop them here.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi GIF e sticker. Puoi anche incollarli con ⌘V o trascinarli qui."
          }
        }
      }
    },
    "Add to Favourites": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi ai preferiti"
          }
        }
      }
    },
    "Added %@ memes to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ meme aggiunti in %2$@"
          }
        }
      }
    },
    "Added to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunto in %@"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti"
          }
        }
      }
    },
    "Allow F4 in System Settings → General → Login Items.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti F4 in Impostazioni di Sistema → Generali → Elementi login."
          }
        }
      }
    },
    "Animated emoji from Google's Noto Emoji (CC BY 4.0) and F4's own stickers, listed after your memes. They stay inside the app and are never copied into your folder.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji animate da Noto Emoji di Google (CC BY 4.0) e sticker di F4, elencati dopo i tuoi meme. Restano dentro l'app e non vengono mai copiati nella tua cartella."
          }
        }
      }
    },
    "Can't read the meme folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riesco a leggere la cartella dei meme"
          }
        }
      }
    },
    "Check Now": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla ora"
          }
        }
      }
    },
    "Check for Updates…": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla aggiornamenti…"
          }
        }
      }
    },
    "Check for updates automatically": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla gli aggiornamenti automaticamente"
          }
        }
      }
    },
    "Choose GIFs and stickers to add to F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le GIF e gli sticker da aggiungere a F4"
          }
        }
      }
    },
    "Choose the folder with your memes": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella con i tuoi meme"
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli…"
          }
        }
      }
    },
    "Click to record a new shortcut": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per registrare una nuova scorciatoia"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia"
          }
        }
      }
    },
    "Couldn't download the image: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare l'immagine: %@"
          }
        }
      }
    },
    "Esc to cancel": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc per annullare"
          }
        }
      }
    },
    "F4 Settings": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni di F4"
          }
        }
      }
    },
    "F4 can only add GIF, PNG, JPEG and WebP images.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 può aggiungere solo immagini GIF, PNG, JPEG e WebP."
          }
        }
      }
    },
    "F4 needs Accessibility access to press ⌘V for you. Until then it only copies.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 ha bisogno dell'accesso Accessibilità per premere ⌘V al posto tuo. Fino ad allora copia e basta."
          }
        }
      }
    },
    "F4 shows the GIF, PNG, JPEG and WebP files in this folder and its subfolders, and updates when you add or remove one. Subfolder names work as categories in search.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 mostra i file GIF, PNG, JPEG e WebP di questa cartella e delle sue sottocartelle, e si aggiorna quando ne aggiungi o togli uno. I nomi delle sottocartelle funzionano come categorie nella ricerca."
          }
        }
      }
    },
    "F4 updates itself: new versions are downloaded from the release feed and installed in one click. Besides this, F4 only goes online to download a link you paste or drop.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 si aggiorna da sola: le nuove versioni vengono scaricate dal feed delle release e installate in un clic. Oltre a questo, F4 va in rete solo per scaricare un link che incolli o trascini."
          }
        }
      }
    },
    "Favourite": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferito"
          }
        }
      }
    },
    "Folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella"
          }
        }
      }
    },
    "GIFs": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Generali"
          }
        }
      }
    },
    "In WhatsApp or Telegram, right-click a sticker and copy it, then press ⌘V here. Or drop stickers on the panel.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In WhatsApp o Telegram fai clic destro su uno sticker e copialo, poi premi ⌘V qui. Oppure trascina gli sticker sul pannello."
          }
        }
      }
    },
    "Meme folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella dei meme"
          }
        }
      }
    },
    "No GIFs yet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna GIF"
          }
        }
      }
    },
    "No memes yet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun meme"
          }
        }
      }
    },
    "No stickers yet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuno sticker"
          }
        }
      }
    },
    "Off: F4 copies the meme and you paste it with ⌘V.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: F4 copia il meme e tu lo incolli con ⌘V."
          }
        }
      }
    },
    "On this Mac the F-keys control the system first, so hold fn with the key. To press it alone, turn on “Use F1, F2, etc. keys as standard function keys” in System Settings › Keyboard › Keyboard Shortcuts › Function Keys.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo Mac i tasti F controllano prima il sistema, quindi tieni premuto fn insieme al tasto. Per premerlo da solo, attiva “Usa i tasti F1, F2 ecc. come tasti funzione standard” in Impostazioni di Sistema › Tastiera › Abbreviazioni da tastiera › Tasti funzione."
          }
        }
      }
    },
    "Open F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri F4"
          }
        }
      }
    },
    "Open F4 at login": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri F4 all'avvio"
          }
        }
      }
    },
    "Open Meme Folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la cartella dei meme"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni"
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla"
          }
        }
      }
    },
    "Paste a GIF or a GIPHY link with ⌘V, drop one here, or click Add.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla una GIF o un link di GIPHY con ⌘V, trascinala qui o fai clic su Aggiungi."
          }
        }
      }
    },
    "Paste a GIF, a sticker or a link with ⌘V, drop files here, or click Add. They are saved in %@.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla una GIF, uno sticker o un link con ⌘V, trascina i file qui o fai clic su Aggiungi. Vengono salvati in %@."
          }
        }
      }
    },
    "Paste into the front app after copying": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla nell'app in primo piano dopo la copia"
          }
        }
      }
    },
    "Press the shortcut…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi la scorciatoia…"
          }
        }
      }
    },
    "Quit F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da F4"
          }
        }
      }
    },
    "Remove from Favourites": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli dai preferiti"
          }
        }
      }
    },
    "Reset": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina"
          }
        }
      }
    },
    "Search memes": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca meme"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni…"
          }
        }
      }
    },
    "Shortcut: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorciatoia: %@"
          }
        }
      }
    },
    "Show and hide F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra e nascondi F4"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra nel Finder"
          }
        }
      }
    },
    "Show the GIFs and stickers built into F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le GIF e gli sticker inclusi in F4"
          }
        }
      }
    },
    "Space": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio"
          }
        }
      }
    },
    "Starter pack": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter pack"
          }
        }
      }
    },
    "Stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticker"
          }
        }
      }
    },
    "Updates": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamenti"
          }
        }
      }
    },
    "Use Folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa cartella"
          }
        }
      }
    },
    "Use ~/Pictures/Memes": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa ~/Immagini/Memes"
          }
        }
      }
    },
    "sticker": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sticker"
          }
        }
      }
    },
    "the file is larger than 50 MB": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "il file supera i 50 MB"
          }
        }
      }
    }
  },
  "version": "1.0"
}
