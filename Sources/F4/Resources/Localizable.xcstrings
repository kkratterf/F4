{
  "sourceLanguage": "en",
  "strings": {
    "%@ could not be downloaded.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non si sono potuti scaricare."
          }
        }
      }
    },
    "%@ is taken by another app. Pick another shortcut.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già usata da un'altra app. Scegline un'altra."
          }
        }
      }
    },
    "About F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informazioni su F4"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi"
          }
        }
      }
    },
    "Add stickers. You can also paste them with ⌘V or drop them here.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi sticker. Puoi anche incollarli con ⌘V o trascinarli qui."
          }
        }
      }
    },
    "Add to Favourites": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi ai preferiti"
          }
        }
      }
    },
    "Added %@ stickers from %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunti %@ sticker da %@"
          }
        }
      }
    },
    "Added %@ stickers to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sticker aggiunti in %2$@"
          }
        }
      }
    },
    "Added 1 sticker from %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunto 1 sticker da %@"
          }
        }
      }
    },
    "Added to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunto in %@"
          }
        }
      }
    },
    "All set: press F4 to open your stickers. fn F4 works too.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto: premi F4 per aprire i tuoi sticker. Funziona anche fn F4."
          }
        }
      }
    },
    "Allow Accessibility…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Accessibilità…"
          }
        }
      }
    },
    "Allow F4 in System Settings → General → Login Items.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti F4 in Impostazioni di Sistema → Generali → Elementi login."
          }
        }
      }
    },
    "Can't read the sticker folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riesco a leggere la cartella degli sticker"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla"
          }
        }
      }
    },
    "Check for Updates…": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla aggiornamenti…"
          }
        }
      }
    },
    "Choose Sticker Folder…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella degli sticker…"
          }
        }
      }
    },
    "Choose stickers or WhatsApp sticker packs (.wastickers) to add. F4 copies them into its own folder, so the originals can stay where they are.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli gli sticker o i pacchetti di sticker di WhatsApp (.wastickers) da aggiungere. F4 li copia nella sua cartella, gli originali possono restare dove sono."
          }
        }
      }
    },
    "Choose the folder with your stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella con i tuoi sticker"
          }
        }
      }
    },
    "Click the star on a sticker, or select it and press ⌘D, to keep it here. Do it again to remove it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca la stella su uno sticker, o selezionalo e premi ⌘D, per tenerlo qui. Rifallo per toglierlo."
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia"
          }
        }
      }
    },
    "Couldn't download the image: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare l'immagine: %@"
          }
        }
      }
    },
    "Create": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea"
          }
        }
      }
    },
    "Downloading %@…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download di %@…"
          }
        }
      }
    },
    "Everything else": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il resto"
          }
        }
      }
    },
    "F4 can catch the F4 key before macOS does, so the key alone opens your stickers. It needs Accessibility access for that: F4 only acts on the F4 key and lets every other key through.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 può intercettare il tasto F4 prima di macOS, così basta il tasto da solo per aprire i tuoi sticker. Per farlo serve l'accesso ad Accessibilità: F4 agisce solo sul tasto F4 e lascia passare tutti gli altri."
          }
        }
      }
    },
    "F4 can only add GIF, PNG, JPEG and WebP images, and WhatsApp sticker packs (.wastickers).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 può aggiungere solo immagini GIF, PNG, JPEG e WebP, e pacchetti di sticker di WhatsApp (.wastickers)."
          }
        }
      }
    },
    "F4 Key Without fn": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasto F4 senza fn"
          }
        }
      }
    },
    "Favourites": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferiti"
          }
        }
      }
    },
    "Folders": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartelle"
          }
        }
      }
    },
    "Folders work as categories: search finds a sticker by its folder too.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle fanno da categorie: la ricerca trova uno sticker anche dalla sua cartella."
          }
        }
      }
    },
    "Keep fn F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni fn F4"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più tardi"
          }
        }
      }
    },
    "Move To": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta in"
          }
        }
      }
    },
    "Move to Trash": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta nel Cestino"
          }
        }
      }
    },
    "Move “%@” to the Trash?": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare “%@” nel Cestino?"
          }
        }
      }
    },
    "Moved %@ to the Trash": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spostato nel Cestino"
          }
        }
      }
    },
    "Moved to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostato in %@"
          }
        }
      }
    },
    "Moved to the top level": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostato fuori dalle cartelle"
          }
        }
      }
    },
    "New Folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuova cartella"
          }
        }
      }
    },
    "New Folder…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuova cartella…"
          }
        }
      }
    },
    "No favourites yet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun preferito"
          }
        }
      }
    },
    "No stickers yet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuno sticker"
          }
        }
      }
    },
    "On this Mac the F4 key opens Spotlight or Launchpad, so for now F4 opens with fn F4.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo Mac il tasto F4 apre Spotlight o Launchpad, quindi per ora F4 si apre con fn F4."
          }
        }
      }
    },
    "Open at Login": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri al login"
          }
        }
      }
    },
    "Open F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri F4"
          }
        }
      }
    },
    "Open F4 with the F4 key": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri F4 con il tasto F4"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni"
          }
        }
      }
    },
    "Open Sticker Folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la cartella degli sticker"
          }
        }
      }
    },
    "Options": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzioni"
          }
        }
      }
    },
    "Or use F1, F2, etc. as standard function keys for every app": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure usa F1, F2, ecc. come tasti funzione standard in tutte le app"
          }
        }
      }
    },
    "Packs": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetti"
          }
        }
      }
    },
    "Paste a sticker or a link with ⌘V, drop files here, or click Add. They are saved in %@.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla uno sticker o un link con ⌘V, trascina i file qui o fai clic su Aggiungi. Vengono salvati in %@."
          }
        }
      }
    },
    "Paste After Copying": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla dopo la copia"
          }
        }
      }
    },
    "Presses ⌘V in the front app after copying. Needs Accessibility access; without it F4 only copies.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preme ⌘V nell'app in primo piano dopo la copia. Serve l'accesso Accessibilità; senza, F4 copia e basta."
          }
        }
      }
    },
    "Quit F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da F4"
          }
        }
      }
    },
    "Recent Stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticker recenti"
          }
        }
      }
    },
    "Remove from Favourites": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli dai preferiti"
          }
        }
      }
    },
    "Rename": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina"
          }
        }
      }
    },
    "Rename Folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina cartella"
          }
        }
      }
    },
    "Rename Sticker": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina sticker"
          }
        }
      }
    },
    "Renamed to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinominato in %@"
          }
        }
      }
    },
    "Rename…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina…"
          }
        }
      }
    },
    "Search finds a sticker by its name, so name it the way you will look for it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca trova uno sticker dal nome: chiamalo come lo cercherai."
          }
        }
      }
    },
    "Search stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca sticker"
          }
        }
      }
    },
    "Search…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca…"
          }
        }
      }
    },
    "Shortcut": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorciatoia"
          }
        }
      }
    },
    "Shortcut: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorciatoia: %@"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra nel Finder"
          }
        }
      }
    },
    "Show Starter Pack": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il pacchetto iniziale"
          }
        }
      }
    },
    "Space": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia"
          }
        }
      }
    },
    "Stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticker"
          }
        }
      }
    },
    "The %@ stickers in it go too. You can put them back from the Trash.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanno anche i %@ sticker che contiene. Puoi recuperarli dal Cestino."
          }
        }
      }
    },
    "The F4 key alone opens F4 instead of Spotlight or Launchpad. Needs Accessibility access; fn F4 always works.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il solo tasto F4 apre F4 invece di Spotlight o Launchpad. Serve l'accesso Accessibilità; fn F4 funziona sempre."
          }
        }
      }
    },
    "the pack has no stickers F4 can download": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "il pack non ha sticker che F4 possa scaricare"
          }
        }
      }
    },
    "The starter pack uses Google's Noto Animated Emoji (CC BY 4.0). F4 goes online only for updates, links you paste or drop, and packs you turn on.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pacchetto iniziale usa le Noto Animated Emoji di Google (CC BY 4.0). F4 va online solo per gli aggiornamenti, per i link che incolli o trascini e per i pacchetti che attivi."
          }
        }
      }
    },
    "The sticker in it goes too. You can put it back from the Trash.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va anche lo sticker che contiene. Puoi recuperarlo dal Cestino."
          }
        }
      }
    },
    "The stickers built into F4, listed after yours.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli sticker inclusi in F4, dopo i tuoi."
          }
        }
      }
    },
    "Top Level": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dalle cartelle"
          }
        }
      }
    },
    "Turn on F4 in System Settings › Privacy & Security › Accessibility. This window updates as soon as you do.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva F4 in Impostazioni di Sistema › Privacy e sicurezza › Accessibilità. Questa finestra si aggiorna appena lo fai."
          }
        }
      }
    },
    "Until then, or if you prefer not to, fn F4 opens F4. You can change this later in F4's menu (F4 Key Without fn).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino ad allora, o se preferisci di no, F4 si apre con fn F4. Puoi cambiarlo dopo dal menu di F4 (Tasto F4 senza fn)."
          }
        }
      }
    },
    "Update to Version %@…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna alla versione %@…"
          }
        }
      }
    },
    "Use Folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa cartella"
          }
        }
      }
    },
    "Use the F4 key alone": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa solo il tasto F4"
          }
        }
      }
    },
    "Welcome to F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuto in F4"
          }
        }
      }
    },
    "sticker": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sticker"
          }
        }
      }
    },
    "the file is larger than 50 MB": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "il file supera i 50 MB"
          }
        }
      }
    },
    "You already have every sticker of %@.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già tutti gli sticker di %@."
          }
        }
      }
    }
  },
  "version": "1.0"
}
