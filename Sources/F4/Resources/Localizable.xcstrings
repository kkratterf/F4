{
  "sourceLanguage": "en",
  "strings": {
    "%@ could not be downloaded.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non si sono potuti scaricare."
          }
        }
      }
    },
    "%@ is taken by another app.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già usato da un'altra app."
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azioni"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi"
          }
        }
      }
    },
    "Add stickers. You can also paste them with ⌘V or drop them here.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi sticker. Puoi anche incollarli con ⌘V o trascinarli qui."
          }
        }
      }
    },
    "Add to Favourites": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi ai preferiti"
          }
        }
      }
    },
    "Add your stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i tuoi sticker"
          }
        }
      }
    },
    "Added %@ stickers from %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunti %@ sticker da %@"
          }
        }
      }
    },
    "Added %@ stickers to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sticker aggiunti in %2$@"
          }
        }
      }
    },
    "Added 1 sticker from %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunto 1 sticker da %@"
          }
        }
      }
    },
    "Added to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunto in %@"
          }
        }
      }
    },
    "Any sticker or image you can copy can live in F4. It takes three keys.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi sticker o immagine che puoi copiare può stare in F4. Bastano tre tasti."
          }
        }
      }
    },
    "Can't read the sticker folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riesco a leggere la cartella degli sticker"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla"
          }
        }
      }
    },
    "Check for Updates…": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla aggiornamenti…"
          }
        }
      }
    },
    "Choose stickers or WhatsApp sticker packs (.wastickers) to add. F4 copies them into its own folder, so the originals can stay where they are.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli gli sticker o i pacchetti di sticker di WhatsApp (.wastickers) da aggiungere. F4 li copia nella sua cartella, gli originali possono restare dove sono."
          }
        }
      }
    },
    "Click the star on a sticker, or select it and press ⌘D, to keep it here. Do it again to remove it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca la stella su uno sticker, o selezionalo e premi ⌘D, per tenerlo qui. Rifallo per toglierlo."
          }
        }
      }
    },
    "Copied to Clipboard": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiato negli appunti"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia"
          }
        }
      }
    },
    "Copy a sticker or an image": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia uno sticker o un'immagine"
          }
        }
      }
    },
    "Couldn't download the image: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare l'immagine: %@"
          }
        }
      }
    },
    "Create": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea"
          }
        }
      }
    },
    "Downloading %@…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download di %@…"
          }
        }
      }
    },
    "Each folder is a tab. ⌘K shows what you can do with a sticker, ⌘M moves it into a folder.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cartella è una scheda. ⌘K mostra cosa puoi fare con uno sticker, ⌘M lo sposta in una cartella."
          }
        }
      }
    },
    "Everything else": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il resto"
          }
        }
      }
    },
    "F4 can only add GIF, PNG, JPEG and WebP images, and WhatsApp sticker packs (.wastickers).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 può aggiungere solo immagini GIF, PNG, JPEG e WebP, e pacchetti di sticker di WhatsApp (.wastickers)."
          }
        }
      }
    },
    "F4 comes with a few stickers to start. The rest is up to you: paste your own, import your WhatsApp packs, or switch on packs from Packs in the menu bar.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 arriva con qualche sticker per iniziare. Il resto lo porti tu: incolla i tuoi, importa i tuoi pack di WhatsApp o attiva dei pacchetti da Pacchetti nella barra dei menu."
          }
        }
      }
    },
    "F4 keeps it as a sticker. A photo or a meme is fitted into a square, whole, nothing cut. ⌥⌘V keeps it exactly as it is.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 lo tiene come sticker. Una foto o un meme entra intero in un quadrato, senza tagli. ⌥⌘V lo tiene esattamente com'è."
          }
        }
      }
    },
    "Favourites": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferiti"
          }
        }
      }
    },
    "Folders": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartelle"
          }
        }
      }
    },
    "Folders work as categories: search finds a sticker by its folder too.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle fanno da categorie: la ricerca trova uno sticker anche dalla sua cartella."
          }
        }
      }
    },
    "From any app.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da qualsiasi app."
          }
        }
      }
    },
    "How to add stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come aggiungere sticker"
          }
        }
      }
    },
    "How to Add Stickers…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come aggiungere sticker…"
          }
        }
      }
    },
    "In WhatsApp, right-click a sticker and choose Copy. Photos, pictures from a website and files in Finder work too.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su WhatsApp, clic destro su uno sticker e scegli Copia. Funzionano anche le foto, le immagini di un sito e i file nel Finder."
          }
        }
      }
    },
    "Move %@ to": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta %@ in"
          }
        }
      }
    },
    "Move To": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta in"
          }
        }
      }
    },
    "Move to Folder…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta in una cartella…"
          }
        }
      }
    },
    "Move to Trash": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta nel Cestino"
          }
        }
      }
    },
    "Move “%@” to the Trash?": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare “%@” nel Cestino?"
          }
        }
      }
    },
    "Moved %@ to the Trash": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spostato nel Cestino"
          }
        }
      }
    },
    "Moved to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostato in %@"
          }
        }
      }
    },
    "Moved to the top level": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostato fuori dalle cartelle"
          }
        }
      }
    },
    "New Folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuova cartella"
          }
        }
      }
    },
    "New Folder…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuova cartella…"
          }
        }
      }
    },
    "No favourites yet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun preferito"
          }
        }
      }
    },
    "No matches": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun risultato"
          }
        }
      }
    },
    "No stickers yet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuno sticker"
          }
        }
      }
    },
    "Open F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri F4"
          }
        }
      }
    },
    "Options": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzioni"
          }
        }
      }
    },
    "Packs": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetti"
          }
        }
      }
    },
    "Paste a sticker or a link with ⌘V, drop files here, or click Add. They are saved in %@.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla uno sticker o un link con ⌘V, trascina i file qui o fai clic su Aggiungi. Vengono salvati in %@."
          }
        }
      }
    },
    "Paste it": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incollalo"
          }
        }
      }
    },
    "Quit F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da F4"
          }
        }
      }
    },
    "Recent Stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticker recenti"
          }
        }
      }
    },
    "Remove from Favourites": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli dai preferiti"
          }
        }
      }
    },
    "Rename": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina"
          }
        }
      }
    },
    "Rename Folder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina cartella"
          }
        }
      }
    },
    "Rename Sticker": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina sticker"
          }
        }
      }
    },
    "Renamed to %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinominato in %@"
          }
        }
      }
    },
    "Rename…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina…"
          }
        }
      }
    },
    "Search actions": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca azioni"
          }
        }
      }
    },
    "Search finds a sticker by its name, so name it the way you will look for it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca trova uno sticker dal nome: chiamalo come lo cercherai."
          }
        }
      }
    },
    "Search stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca sticker"
          }
        }
      }
    },
    "Search…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca…"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra nel Finder"
          }
        }
      }
    },
    "Show Starter Pack": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il pacchetto iniziale"
          }
        }
      }
    },
    "Space": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio"
          }
        }
      }
    },
    "Stickers": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticker"
          }
        }
      }
    },
    "The %@ stickers in it go too. You can put them back from the Trash.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanno anche i %@ sticker che contiene. Puoi recuperarli dal Cestino."
          }
        }
      }
    },
    "the pack has no stickers F4 can download": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "il pack non ha sticker che F4 possa scaricare"
          }
        }
      }
    },
    "The sticker in it goes too. You can put it back from the Trash.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va anche lo sticker che contiene. Puoi recuperarlo dal Cestino."
          }
        }
      }
    },
    "The stickers built into F4, listed after yours.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli sticker inclusi in F4, dopo i tuoi."
          }
        }
      }
    },
    "To send one: fn F4, type, Enter. It is copied: paste it with ⌘V wherever you want.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mandarne uno: fn F4, scrivi, Invio. È copiato: incollalo con ⌘V dove vuoi."
          }
        }
      }
    },
    "Top Level": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dalle cartelle"
          }
        }
      }
    },
    "Update to Version %@…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna alla versione %@…"
          }
        }
      }
    },
    "sticker": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sticker"
          }
        }
      }
    },
    "the file is larger than 50 MB": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "il file supera i 50 MB"
          }
        }
      }
    },
    "Welcome to F4": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuto in F4"
          }
        }
      }
    },
    "You already have every sticker of %@.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già tutti gli sticker di %@."
          }
        }
      }
    }
  },
  "version": "1.0"
}
